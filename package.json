{
  "name": "raboteriya-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm-run-all --parallel css:watch serve",
    "dev": "npm start",
    "serve": "eleventy --serve --incremental",
    "build": "npm-run-all bundle:js css:build build:site",
    "optimize:images": "node scripts/optimize-images.js",
    "bundle:js": "node scripts/bundle-js.js",
    "build:site": "eleventy",
    "css:build": "tailwindcss -i ./src/assets/css/tailwind.css -o ./_site/assets/css/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/assets/css/tailwind.css -o ./_site/assets/css/styles.css --watch",
    "i18n:length": "node scripts/check-i18n-length.js",
    "deploy": "echo 'Use GitHub Actions instead'",
    "postinstall": "node scripts/copy-pdfjs.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "dotenv": "^16.0.0"
  }
}
