{% from "macros/i18n.njk" import localeClass %}
{% from "macros/image.njk" import responsiveImg %}
<header class="site-header sticky top-0 z-[100] bg-page transition-shadow duration-200" id="site-header">
  <div class="container-custom flex items-center justify-between py-4">
    <a href="{{ '/' | url }}" class="font-semibold text-lg flex items-center gap-2" aria-label="{{ site.brand.name }} home">
      {% if site.brand.logo %}
        {{ responsiveImg(site.brand.logo, {
          alt: site.brand.logoAlt | default(site.brand.name),
          class: "h-8 w-auto md:h-9",
          sizes: "140px",
          maxWidth: 280,
          loading: "eager"
        }) }}
      {% else %}
        <span class="text-brand-primary">{{ site.brand.name }}</span>
      {% endif %}
    </a>
    <div class="hidden lg:flex items-center gap-6 xl:gap-8">
      {% for locale in i18n.locales %}
      {% set nav = i18n.nav[locale] %}
      <nav class="flex items-center gap-5 xl:gap-6 {{ localeClass(locale) }}" data-locale="{{ locale }}" aria-label="Main">
        {% for item in nav.header %}
          {% if not item.hideOnDesktop %}
          <a href="{{ item.url }}" class="text-gray-700 hover:text-brand-primary text-sm lg:text-lg whitespace-nowrap">{{ item.label }}</a>
          {% endif %}
        {% endfor %}
      </nav>
      {% endfor %}
      {% include "lang-toggle.njk" %}
      {% for locale in i18n.locales %}
      {% set nav = i18n.nav[locale] %}
      {% if nav.headerCta %}
      <a href="{{ nav.headerCta.url }}" class="{{ localeClass(locale) }} px-5 py-2.5 lg:px-6 lg:py-3 lg:text-lg rounded-xl bg-brown-900 text-white font-medium hover:brightness-110 shrink-0 transition-[filter]" data-locale="{{ locale }}">{{ nav.headerCta.label }}</a>
      {% endif %}
      {% endfor %}
    </div>
    <div class="flex items-center gap-2 lg:hidden">
      {% include "lang-toggle.njk" %}
      <div class="mobile-nav-spacer h-10 w-12 shrink-0" aria-hidden="true"></div>
    </div>
  </div>
</header>

{# Mobile menu outside header so overlay + close button stay above content when scrolled #}
<div id="mobile-nav" class="mobile-nav lg:hidden">
  <input type="checkbox" id="mobile-menu-input" class="mobile-menu-input" aria-hidden="true" tabindex="-1" />
  <label
    for="mobile-menu-input"
    id="mobile-menu-toggle"
    class="mobile-menu-toggle"
    aria-label="{{ i18n.ui.en.openMenu }}"
    data-i18n-ui="openMenu"
    aria-expanded="false"
    aria-controls="mobile-menu-overlay"
  ><span></span></label>
  <div id="mobile-menu-overlay" class="mobile-menu-overlay" role="dialog" aria-modal="true" aria-hidden="true">
    <nav class="mobile-menu-nav" aria-label="Mobile">
      <ul class="mobile-menu-list">
        {# Hardcoded mobile menu — EN #}
        <li class="i18n-locale" data-locale="en"><a href="#hero" class="mobile-menu-link">Home</a></li>
        <li class="i18n-locale" data-locale="en"><a href="#about" class="mobile-menu-link">About</a></li>
        <li class="i18n-locale" data-locale="en"><a href="#why-raboteriya" class="mobile-menu-link">Why choose us</a></li>
        <li class="i18n-locale" data-locale="en"><a href="#the-space" class="mobile-menu-link">The space</a></li>
        <li class="i18n-locale" data-locale="en"><a href="#memberships" class="mobile-menu-link">Memberships</a></li>
        <li class="i18n-locale" data-locale="en"><a href="#testimonials" class="mobile-menu-link">Reviews</a></li>
        <li class="i18n-locale" data-locale="en"><a href="#community" class="mobile-menu-link">Community</a></li>
        <li class="i18n-locale" data-locale="en"><a href="#contact" class="mobile-menu-link">Contact</a></li>
        {# Hardcoded mobile menu — BG #}
        <li class="i18n-locale i18n-hidden" data-locale="bg" hidden><a href="#hero" class="mobile-menu-link">Нач.</a></li>
        <li class="i18n-locale i18n-hidden" data-locale="bg" hidden><a href="#about" class="mobile-menu-link">Инфо</a></li>
        <li class="i18n-locale i18n-hidden" data-locale="bg" hidden><a href="#why-raboteriya" class="mobile-menu-link">Защо ние</a></li>
        <li class="i18n-locale i18n-hidden" data-locale="bg" hidden><a href="#the-space" class="mobile-menu-link">Място</a></li>
        <li class="i18n-locale i18n-hidden" data-locale="bg" hidden><a href="#memberships" class="mobile-menu-link">Членства</a></li>
        <li class="i18n-locale i18n-hidden" data-locale="bg" hidden><a href="#testimonials" class="mobile-menu-link">Отзиви</a></li>
        <li class="i18n-locale i18n-hidden" data-locale="bg" hidden><a href="#community" class="mobile-menu-link">Общност</a></li>
        <li class="i18n-locale i18n-hidden" data-locale="bg" hidden><a href="#contact" class="mobile-menu-link">Контакт</a></li>
      </ul>
    </nav>
  </div>
</div>
