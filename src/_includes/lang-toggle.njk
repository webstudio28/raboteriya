{% if i18n.locales.length > 1 %}
<div class="lang-toggle" role="group" aria-label="{{ i18n.ui.en.languageToggle }}">
  <span class="lang-toggle__thumb" aria-hidden="true"></span>
  {% for locale in i18n.locales %}
  <button
    type="button"
    class="lang-toggle__btn{% if locale == i18n.defaultLocale %} is-active{% endif %}"
    data-lang="{{ locale }}"
    aria-pressed="{{ 'true' if locale == i18n.defaultLocale else 'false' }}"
    aria-label="{{ i18n.localeLabels[locale] }}"
  >{{ i18n.localeLabels[locale] }}</button>
  {% endfor %}
</div>
{% endif %}
