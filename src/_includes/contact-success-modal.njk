{# Contact form — success state after enquiry submit #}
<dialog
  id="contact-success-modal"
  class="contact-success-modal fixed inset-0 z-[200] m-0 h-full max-h-none w-full max-w-none overflow-y-auto border-0 bg-transparent p-4 open:flex open:items-center open:justify-center"
  aria-labelledby="contact-success-title"
>
  <div class="contact-success-modal-panel w-full max-w-md rounded-2xl border border-gray-200 bg-white p-6 shadow-xl md:p-8">
    <div class="flex justify-end">
      <button
        type="button"
        id="contact-success-close"
        class="-m-2 rounded-lg p-2 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900"
        aria-label="{{ i18n.ui.en.close }}"
        data-i18n-ui="close"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <div class="py-4 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-600" aria-hidden="true">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <h2 id="contact-success-title" class="mt-5 text-xl font-black text-gray-900 sm:text-2xl" data-i18n-modal="contactSuccessTitle">{{ i18n.modals.en.contactSuccessTitle }}</h2>
      <p class="mt-3 text-base leading-relaxed text-gray-600" data-i18n-modal="contactSuccessBody">
        {{ i18n.modals.en.contactSuccessBody }}
      </p>
      <button
        type="button"
        id="contact-success-done"
        class="mt-8 inline-flex w-full justify-center rounded-xl bg-gray-900 px-6 py-3.5 text-base font-bold text-white transition-colors hover:bg-gray-800"
        data-i18n-modal="contactDone"
      >
        {{ i18n.modals.en.contactDone }}
      </button>
    </div>
  </div>
</dialog>