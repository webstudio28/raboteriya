{# Contact â€” two-column: left info, right form + socials #}
{% from "macros/i18n.njk" import localeClass %}
<section class="section-padding bg-page" id="contact">
  {% for locale in i18n.locales %}
  {% set c = i18n.home[locale].contact %}
  {% set ui = i18n.ui[locale] %}
  <div class="container-custom {{ localeClass(locale) }}" data-locale="{{ locale }}">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20">
      <div class="flex flex-col">
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 leading-tight">
          {{ c.heading | default('Ready to join us?') }}
        </h2>

        <p class="mt-6 text-base md:text-lg text-gray-700 whitespace-pre-line leading-relaxed">{{ c.description | default("Give us a call or fill out the enquiry form.\nWe'll get back to you as soon as possible.") }}</p>

        {% if c.note %}
        <p class="mt-6 text-base md:text-lg text-gray-700 leading-relaxed">{{ c.note }}</p>
        {% endif %}

        <div class="mt-auto pt-12 space-y-5">
          {% if c.email %}
          <div class="flex items-center gap-4">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-gray-900 text-white flex items-center justify-center">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <div>
              <p class="text-xs text-gray-500 font-medium tracking-wide">{{ ui.emailLabel }}</p>
              <a href="mailto:{{ c.email }}" class="text-base font-medium text-gray-900 hover:text-brand-primary">{{ c.email }}</a>
            </div>
          </div>
          {% endif %}

          {% if c.phone %}
          <div class="flex items-center gap-4">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-gray-900 text-white flex items-center justify-center">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <div>
              <p class="text-xs text-gray-500 font-medium tracking-wide">{{ ui.phoneLabel }}</p>
              <a href="tel:{{ c.phone | replace(' ', '') }}" class="text-base font-medium text-gray-900 hover:text-brand-primary">{{ c.phone }}</a>
            </div>
          </div>
          {% endif %}

          {% if c.address %}
          <div class="flex items-center gap-4">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-gray-900 text-white flex items-center justify-center">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div>
              <p class="text-xs text-gray-500 font-medium tracking-wide">{{ ui.addressLabel }}</p>
              <p class="text-base font-medium text-gray-900">{{ c.address }}</p>
            </div>
          </div>
          {% endif %}
        </div>
      </div>

      <div class="flex flex-col">
        <form class="js-contact-form flex flex-col gap-4" action="https://api.web3forms.com/submit" method="post">
          <input type="hidden" name="access_key" value="2b37c752-1bab-422c-ae2f-332fb1ae5d8d">
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none">
          <input type="hidden" name="subject" class="js-contact-subject" value="Raboteriya â€” contact enquiry">
          <textarea name="message" class="js-contact-message hidden" aria-hidden="true" tabindex="-1"></textarea>
          <p class="contact-form-error hidden rounded-xl bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"></p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <input type="text" name="name" placeholder="{{ ui.contactNamePlaceholder }}" required
              class="w-full rounded-xl border-2 border-gray-900/70 bg-transparent px-5 py-3.5 text-base text-gray-900 placeholder-gray-500 outline-none focus:border-gray-900 transition-colors">
            <input type="tel" name="phone" placeholder="{{ ui.contactPhonePlaceholder }}" required
              class="w-full rounded-xl border-2 border-gray-900/70 bg-transparent px-5 py-3.5 text-base text-gray-900 placeholder-gray-500 outline-none focus:border-gray-900 transition-colors">
          </div>
          <input type="email" name="email" placeholder="{{ ui.contactEmailPlaceholder }}" required
            class="w-full rounded-xl border-2 border-gray-900/70 bg-transparent px-5 py-3.5 text-base text-gray-900 placeholder-gray-500 outline-none focus:border-gray-900 transition-colors">
          <textarea name="enquiry" rows="5" placeholder="{{ c.formPlaceholder | default('Let us know when you would like to visit, or simply leave your phone number and we will give you a call') }}" required
            class="w-full rounded-xl border-2 border-gray-900/70 bg-transparent px-5 py-3.5 text-base text-gray-900 placeholder-gray-500 outline-none focus:border-gray-900 transition-colors resize-none"></textarea>
          <div>
            <button type="submit"
              class="js-contact-submit mt-1 inline-block rounded-full bg-gray-900 px-8 py-3.5 text-base font-bold text-white hover:bg-gray-800 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
              {{ c.submitLabel | default('Submit your message') }}
            </button>
          </div>
        </form>

        <div class="mt-auto pt-10">
          {% if c.socialsHeading %}
          <p class="text-base font-bold text-gray-900">{{ c.socialsHeading }}</p>
          {% endif %}

          {% if c.socials and c.socials.length %}
          <div class="mt-3 flex items-center gap-3">
            {% for s in c.socials %}
            <a href="{{ s.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ s.platform }}"
              class="flex-shrink-0 w-10 h-10 rounded-full bg-gray-900 text-white flex items-center justify-center hover:bg-gray-800 transition-colors">
              {% if s.icon == "facebook" %}
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              {% elif s.icon == "instagram" %}
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              {% elif s.icon == "linkedin" %}
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              {% elif s.icon == "tiktok" %}
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.52a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.8a8.24 8.24 0 0 0 4.76 1.5V6.85a4.84 4.84 0 0 1-1-.16z"/></svg>
              {% elif s.icon == "whatsapp" %}
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              {% elif s.icon == "viber" %}
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 15.703c-.232.697-1.384 1.314-1.903 1.401-.484.081-1.089.116-1.758-.118-.407-.126-.928-.295-1.593-.58-2.801-1.214-4.621-4.043-4.762-4.235-.14-.193-1.14-1.518-1.14-2.898 0-1.38.723-2.058.978-2.339.255-.28.555-.35.74-.35.186 0 .372.002.535.01.163.01.381-.062.595.465.215.526.732 1.791.796 1.921.064.13.107.28.021.453-.086.174-.13.279-.26.43-.13.151-.274.337-.39.505-.13.168-.265.347-.114.655.151.309.67 1.105 1.438 1.793.989.881 1.821 1.156 2.092 1.285.27.129.427.108.595-.065.168-.174.696-.813.882-1.094.186-.28.372-.233.63-.14.26.093 1.644.775 1.926.916.282.14.47.21.541.326.07.116.07.674-.163 1.37z"/></svg>
              {% endif %}
            </a>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {% endfor %}
</section>
