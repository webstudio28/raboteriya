{# Two-column section: left box 1/3 (image), right box 2/3 (testimony text) #}
{% from "macros/i18n.njk" import localeClass %}
<section class="bg-page pt-0 pb-16 md:pb-24" id="split-section">
  <div class="container-custom lg:flex lg:items-stretch lg:gap-12">
    <div class="hidden lg:block lg:w-1/3">
      <div class="h-full rounded-xl bg-gray-200 overflow-hidden flex items-center justify-center">
        <div class="w-full aspect-[3/4] bg-gray-300 flex items-center justify-center text-gray-600 text-sm md:text-base">
          {{ i18n.ui.en.placeholderImage }}
        </div>
      </div>
    </div>

    {% for locale in i18n.locales %}
    {% set ui = i18n.ui[locale] %}
    <div class="mt-12 lg:mt-0 w-full lg:w-2/3 flex items-stretch {{ localeClass(locale) }}" data-locale="{{ locale }}">
      <div class="rounded-xl border border-gray-200 bg-white shadow-xl p-6 md:p-8 max-w-full h-full flex items-center">
        <div class="w-full">
          <span class="inline-block float-left mr-4 mb-2 w-48 h-48 bg-gray-300 rounded-lg lg:hidden"></span>
          <p class="text-base md:text-lg text-gray-900 whitespace-pre-line">{{ ui.splitSectionQuote }}</p>
          <p class="mt-6 text-right text-base md:text-lg font-semibold text-gray-900">
            {{ ui.splitSectionAttribution }}
          </p>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
