{# Memberships + included benefits — intro, extras carousel, pricing cards #}
{% from "macros/i18n.njk" import localeClass %}
<section class="section-padding bg-page" id="memberships">
  {% for locale in i18n.locales %}
  {% set m = i18n.home[locale].memberships %}
  {% set e = i18n.home[locale].extras %}
  <div class="{{ localeClass(locale) }}" data-locale="{{ locale }}">
  <div class="container-custom">
    <div class="text-center">
      <h2 class="text-3xl font-black leading-tight text-gray-900 md:text-4xl lg:text-5xl">{{ m.heading | default("We don't believe in hidden fees") }}</h2>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-gray-900 md:mt-8">{{ m.paragraph | default("Everything you need to work better is included in your day pass or membership.") }}</p>
    </div>
  </div>

  <div class="extras-strip-wrapper mt-12 md:mt-16">
    <div class="extras-strip" aria-hidden="true">
      <div class="extras-strip-set">
        {% for item in (e.items or []) %}
        <div class="extras-card">
          <img src="{{ item.icon | default('/assets/images/benefit-default-icon.png') | url }}" alt="" class="extras-card__icon" width="52" height="52" draggable="false" loading="lazy" />
          <p class="extras-card__title">{{ item.title }}</p>
        </div>
        {% endfor %}
      </div>
      <div class="extras-strip-set">
        {% for item in (e.items or []) %}
        <div class="extras-card">
          <img src="{{ item.icon | default('/assets/images/benefit-default-icon.png') | url }}" alt="" class="extras-card__icon" width="52" height="52" draggable="false" loading="lazy" />
          <p class="extras-card__title">{{ item.title }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="container-custom mt-12 md:mt-16">
    {% set cards = m.cards or [] %}
    <div class="pricing-row-scroll max-sm:-mx-4">
    <div class="pricing-row flex max-sm:flex-nowrap max-sm:gap-5 max-sm:w-max sm:grid sm:grid-cols-2 sm:items-stretch sm:gap-6 sm:overflow-visible md:gap-8 lg:grid-cols-4">
      {% for card in cards %}
      <div class="pricing-card-wrapper flex flex-col gap-4 max-sm:w-[min(280px,88vw)] max-sm:shrink-0 sm:h-full sm:w-auto">
        <article class="pricing-card flex min-h-0 flex-1 flex-col overflow-hidden bg-white rounded-3xl">
          <div class="pricing-card__body flex flex-col p-7 md:p-7{% if not card.footnote %} flex-1{% endif %}">
          <div class="pricing-card-header flex items-center justify-between gap-2">
            <span class="min-w-0 text-[0.65rem] font-semibold uppercase tracking-widest text-gray-400 leading-snug">{{ card.title }}</span>
            {% if card.badge %}
            <span class="pricing-card-badge inline-flex shrink-0 items-center gap-1.5 rounded-full bg-rose-50 px-2.5 py-1 text-[11px] font-semibold leading-none tracking-wide text-rose-700">
              <svg class="h-3 w-3 shrink-0 text-red-500" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 13.35S2.5 9.58 2.5 5.75c0-1.93 1.57-3.5 3.5-3.5 1.1 0 2.1.52 2.75 1.34.65-.82 1.65-1.34 2.75-1.34 1.93 0 3.5 1.57 3.5 3.5 0 3.83-5.5 7.6-5.5 7.6z"/>
              </svg>
              {{ card.badge }}
            </span>
            {% endif %}
          </div>

          <div class="pricing-card-price mt-2 flex min-h-[3rem] items-baseline gap-2">
            <span class="text-4xl font-medium leading-none text-gray-900 md:text-5xl">{{ card.price }}</span>
            <span class="text-base font-normal text-gray-400">{{ card.period }}</span>
          </div>

          <hr class="pricing-card-divider mt-3 mb-4 border-gray-200" />

          <ul class="flex flex-col gap-3.5 m-0 list-none p-0{% if not card.footnote %} flex-1{% endif %}">
            {% for item in (card.inclusions or []) %}
            <li class="flex items-start gap-3">
              <span class="shrink-0 mt-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-gray-900" aria-hidden="true">
                <svg width="8" height="8" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9.5 2.5L4.25 7.75L1.5 5" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="text-base text-gray-800 leading-snug">{{ item }}</span>
            </li>
            {% endfor %}
          </ul>
          </div>

          {% if card.footnote %}
          <div class="pricing-card-footnote">
            <p class="text-sm font-medium leading-snug text-gray-900">{{ card.footnote.title }}. {{ card.footnote.text }}</p>
          </div>
          {% endif %}
        </article>

        <button
          type="button"
          class="pricing-cta js-booking-modal-open shrink-0 flex w-full items-center justify-center gap-2.5 rounded-2xl border-0 px-6 py-4 text-base font-normal text-white cursor-pointer"
          data-membership-plan="{{ card.title }}"
          data-membership-price="{{ card.price }}{{ card.period }}"
        >
          {{ i18n.ui[locale].bookVisit }}
          <span aria-hidden="true" class="text-lg leading-none">→</span>
        </button>
      </div>
      {% endfor %}
      <div class="pricing-row__end max-sm:block sm:hidden" aria-hidden="true"></div>
    </div>
    </div>
  </div>
  </div>
  {% endfor %}
</section>
