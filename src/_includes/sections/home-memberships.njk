{# Memberships — pricing cards; Resident tier featured with subtle emphasis #}
<section class="section-padding bg-page" id="memberships">
  <div class="container-custom">
    {% set m = home.memberships if home and home.memberships else {} %}
    <div class="text-center">
      <h2 class="text-3xl font-black leading-tight text-gray-900 md:text-4xl lg:text-5xl">{{ m.heading | default('Memberships, Day Passes & Pricing') }}</h2>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-gray-900 md:mt-8">{{ m.paragraph | default('') }}</p>
    </div>

    <div class="mt-12 md:mt-16 max-sm:-mx-4 max-sm:px-4">
      <div class="pricing-row flex max-sm:flex-nowrap max-sm:gap-5 max-sm:overflow-x-auto max-sm:overflow-y-visible max-sm:pb-3 [-webkit-overflow-scrolling:touch] sm:grid sm:grid-cols-2 sm:items-stretch sm:gap-6 sm:overflow-visible sm:pb-0 md:gap-8 lg:grid-cols-4">
        {% for card in (m.cards or []) %}
        <div class="pricing-card-wrapper flex flex-col gap-4 max-sm:w-[min(280px,88vw)] max-sm:shrink-0 sm:h-full sm:w-auto {{ 'pricing-card-wrapper--featured max-sm:order-first max-sm:w-[min(300px,92vw)] lg:scale-[1.04] lg:z-10' if card.featured else '' }}">
          <article class="pricing-card flex min-h-0 flex-1 flex-col bg-white rounded-3xl p-7 md:p-7 {{ 'pricing-card--featured ring-1 ring-gray-900/10' if card.featured else '' }}">
            <div class="pricing-card-header flex min-h-[2.25rem] items-start justify-between gap-3">
              <span class="text-xs font-semibold uppercase tracking-widest text-gray-400 pt-0.5 leading-snug">{{ card.title }}</span>
              {% set badgeLabel = card.badge | default('Most Loved') %}
              {% if card.featured %}
              <span class="shrink-0 rounded-full bg-gray-900 px-3 py-1 text-xs font-semibold text-white">{{ badgeLabel }}</span>
              {% else %}
              <span class="invisible shrink-0 rounded-full px-3 py-1 text-xs font-semibold" aria-hidden="true">{{ badgeLabel }}</span>
              {% endif %}
            </div>

            <div class="pricing-card-price mt-2 flex min-h-[3rem] items-baseline gap-2">
              <span class="text-4xl font-medium leading-none text-gray-900 md:text-5xl">{{ card.price }}</span>
              <span class="text-base font-normal text-gray-400">{{ card.period }}</span>
            </div>

            <hr class="pricing-card-divider mt-3 mb-4 border-gray-200" />

            <ul class="flex flex-col gap-3.5 flex-1 m-0 list-none p-0">
              {% for item in (card.inclusions or []) %}
              <li class="flex items-start gap-3">
                <span class="shrink-0 mt-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-gray-900" aria-hidden="true">
                  <svg width="8" height="8" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9.5 2.5L4.25 7.75L1.5 5" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="text-base text-gray-800 leading-snug">{{ item }}</span>
              </li>
              {% endfor %}
            </ul>
          </article>

          <button
            type="button"
            class="pricing-cta js-booking-modal-open shrink-0 flex w-full items-center justify-center gap-2.5 rounded-2xl border-0 px-6 py-4 text-base font-normal text-white cursor-pointer"
            data-membership-plan="{{ card.title }}"
            data-membership-price="{{ card.price }}{{ card.period }}"
          >
            Book a visit
            <span aria-hidden="true" class="text-lg leading-none">→</span>
          </button>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
