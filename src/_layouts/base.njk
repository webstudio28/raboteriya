<!DOCTYPE html>
<html lang="{% if site and site.brand %}{{ site.brand.language }}{% else %}en{% endif %}">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y0034FTM57"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-Y0034FTM57');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }}{% elif site and site.seo %}{{ site.seo.defaultTitle }}{% else %}Landing{% endif %}</title>
  <meta name="description" content="{% if description %}{{ description }}{% elif site and site.seo %}{{ site.seo.defaultDescription }}{% endif %}">
  <link rel="canonical" href="{% if site and site.seo %}{{ site.seo.siteUrl }}{{ page.url | url }}{% endif %}">
  <meta property="og:url" content="{% if site and site.seo %}{{ site.seo.siteUrl }}{{ page.url | url }}{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{% if title %}{{ title }}{% elif site and site.seo %}{{ site.seo.defaultTitle }}{% endif %}">
  <meta property="og:description" content="{% if description %}{{ description }}{% elif site and site.seo %}{{ site.seo.defaultDescription }}{% endif %}">
  <meta property="og:image" content="{% if site and site.seo %}{{ site.seo.siteUrl }}{{ site.seo.ogImage }}{% endif %}">
  <meta name="twitter:card" content="{% if site and site.seo %}{{ site.seo.twitterCard }}{% else %}summary_large_image{% endif %}">
  <meta name="twitter:title" content="{% if title %}{{ title }}{% elif site and site.seo %}{{ site.seo.defaultTitle }}{% endif %}">
  <meta name="twitter:description" content="{% if description %}{{ description }}{% elif site and site.seo %}{{ site.seo.defaultDescription }}{% endif %}">
  <meta name="twitter:image" content="{% if site and site.seo %}{{ site.seo.siteUrl }}{{ site.seo.ogImage }}{% endif %}">
  <link rel="icon" type="image/png" href="{{ '/favicon.png' | url }}">
  <link rel="apple-touch-icon" href="{{ '/favicon.png' | url }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Raboteriya Coworking Space Plovdiv",
    "alternateName": "Raboteriya",
    "url": "https://raboteriya.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://raboteriya.com/assets/images/logo.png"
    },
    "image": "https://raboteriya.com/assets/images/about.png",
    "description": "A homey coworking space in Plovdiv for freelancers and remote workers. Day pass from €11, monthly memberships from €79. Members get 24/7 keycard access. Located at bul. Vasil Aprilov 49, close to Plovdiv city centre. Staff available Monday–Sunday 08:00–20:00.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "bul. Vasil Aprilov 49",
      "addressLocality": "Plovdiv",
      "postalCode": "4000",
      "addressCountry": "BG"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 42.14282,
      "longitude": 24.73015
    },
    "telephone": "+359894431048",
    "email": "cwsaprilov@gmail.com",
    "openingHours": "Mo-Su 08:00-20:00",
    "priceRange": "€€",
    "currenciesAccepted": "EUR, BGN",
    "sameAs": [
      "https://www.facebook.com/raboteriya",
      "https://www.instagram.com/raboteriya",
      "https://www.linkedin.com/company/coworking-space-aprilov/",
      "https://www.tiktok.com/@raboteriya"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "bestRating": "5",
      "worstRating": "1",
      "reviewCount": "22"
    },
    "amenityFeature": [
      { "@type": "LocationFeatureSpecification", "name": "Free High-Speed WiFi", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Static IP WiFi", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "24/7 Member Access", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Private Phone Booth", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Quiet Focus Room", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Free Coffee and Tea", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Free Snacks and Fresh Fruits", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Extra Monitors", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Standing Desks", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Printing", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Free Street Parking", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Pet Friendly", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Garden", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Lounge Area", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "PlayStation", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Company Address Registration", "value": true }
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for item in home.faq.items %}
      {% if item.list %}
      {% set faqAnswer = item.answer + " " + (item.list | join(". ")) %}
      {% if item.answerFooter %}{% set faqAnswer = faqAnswer + " " + item.answerFooter %}{% endif %}
      {% else %}
      {% set faqAnswer = item.answer %}
      {% endif %}
      {
        "@type": "Question",
        "name": {{ item.question | dump | safe }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ faqAnswer | dump | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  <link rel="preload" href="{{ '/assets/fonts/HelveticaNowDisplay-Black.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  {% set heroLcp = "/assets/images/hero-bg-mobile.jpg" | optImg(828) %}
  <link rel="preload" href="{{ heroLcp | url }}" as="image" fetchpriority="high">
  <link rel="stylesheet" href="{{ '/assets/css/styles.css' | url }}?v={{ stylesheetVersion }}">
  <script>
    window.__I18N__ = {{ i18n | dump | safe }};
  </script>
  <script>
    window.addEventListener("load", function () {
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "wsm8zrpe1o");
    });
  </script>
</head>
<body{% if site and site.colors %} style="--color-brand-primary: {{ site.colors.primary }}; --color-brand-secondary: {{ site.colors.secondary }}; --color-brand-accent: {{ site.colors.accent }};"{% endif %}>
  {% include "header.njk" %}
  {{ content | safe }}
  {% include "discount-modal.njk" %}
  {% include "booking-modal.njk" %}
  {% include "contact-success-modal.njk" %}
  {% include "space-gallery-modal.njk" %}
  {% include "community-video-modal.njk" %}
  {% include "testimonial-modal.njk" %}
  {% include "contact-widget.njk" %}
  <script src="{{ '/assets/js/site.bundle.js' | url }}?v={{ stylesheetVersion }}" defer></script>
  <script data-goatcounter="https://raboteriya.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
</body>
</html>
